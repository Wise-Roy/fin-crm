generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                       String          @id @default(uuid()) @db.Uuid
  tenantId                                 String          @map("tenant_id") @db.Uuid
  name                                     String          @db.VarChar(255)
  email                                    String          @db.VarChar(255)
  phone                                    String?         @db.VarChar(20)
  role                                     user_role
  position                                 String?         @db.VarChar(100)
  is_active                                Boolean         @default(true)
  createdAt                                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  password_hash                            String          @default("")
  notifications                            notifications[]
  task_task_assigned_to_employee_idTousers task[]          @relation("task_assigned_to_employee_idTousers")
  task_task_created_byTousers              task[]          @relation("task_created_byTousers")
  task_history                             task_history[]
  join_requests_responded                  join_request[]  @relation("join_request_responder")
  tenant                                   tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, email])
  @@index([tenantId, role], map: "idx_users_role")
  @@index([tenantId], map: "idx_users_tenant")
  @@map("users")
}

model categories {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String           @db.Uuid
  name           String           @db.VarChar(150)
  is_predefined  Boolean          @default(false)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  tenant         tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sub_categories sub_categories[]
  task           task[]

  @@unique([tenant_id, name], map: "categories_name_unique")
  @@index([tenant_id], map: "idx_categories_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model client {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String         @db.Uuid
  name         String         @db.VarChar(255)
  email        String?        @db.VarChar(255)
  phone        String?        @db.VarChar(20)
  is_active    Boolean        @default(true)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  tenant       tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  client_group client_group[]
  task         task[]

  @@unique([tenant_id, name], map: "client_name_unique_per_tenant")
  @@index([tenant_id], map: "idx_client_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model client_group {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  client_id  String   @db.Uuid
  group_name String   @db.VarChar(255)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(20)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  client     client   @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant     tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task       task[]

  @@unique([client_id, group_name], map: "client_group_name_unique")
  @@index([client_id], map: "idx_client_group_client")
  @@index([tenant_id], map: "idx_client_group_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @db.Uuid
  task_id    String?  @db.Uuid
  title      String   @db.VarChar(255)
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  task       task?    @relation(fields: [task_id], references: [id], onUpdate: NoAction)
  tenant     tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_notifications_created")
  @@index([user_id, is_read], map: "idx_notifications_unread")
  @@index([user_id], map: "idx_notifications_user")
}

model sub_categories {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String     @db.Uuid
  category_id String     @db.Uuid
  name        String     @db.VarChar(150)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant      tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task        task[]

  @@unique([category_id, name], map: "sub_categories_name_unique")
  @@index([category_id], map: "idx_sub_categories_category")
  @@index([tenant_id], map: "idx_sub_categories_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model task {
  id                                        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                                 String               @db.Uuid
  title                                     String               @db.VarChar(255)
  description                               String?
  category_id                               String?              @db.Uuid
  subcategory_id                            String?              @db.Uuid
  assigned_to_employee_id                   String?              @db.Uuid
  client_id                                 String?              @db.Uuid
  client_group_id                           String?              @db.Uuid
  created_by                                String               @db.Uuid
  status                                    task_status          @default(TODO)
  priority                                  task_priority        @default(MEDIUM)
  due_date                                  DateTime?            @db.Timestamptz(6)
  completed_at                              DateTime?            @db.Timestamptz(6)
  created_at                                DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime             @default(now()) @db.Timestamptz(6)
  notifications                             notifications[]
  users_task_assigned_to_employee_idTousers User?                @relation("task_assigned_to_employee_idTousers", fields: [assigned_to_employee_id], references: [id], onUpdate: NoAction)
  categories                                categories?          @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  client_group                              client_group?        @relation(fields: [client_group_id], references: [id], onUpdate: NoAction)
  client                                    client?              @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  users_task_created_byTousers              User                 @relation("task_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  sub_categories                            sub_categories?      @relation(fields: [subcategory_id], references: [id], onUpdate: NoAction)
  tenant                                    tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task_history                              task_history[]
  task_payment                              task_payment[]
  task_reimbursement                        task_reimbursement[]

  @@index([tenant_id, category_id], map: "idx_task_category")
  @@index([tenant_id, client_id], map: "idx_task_client")
  @@index([tenant_id, client_group_id], map: "idx_task_client_group")
  @@index([tenant_id, created_at(sort: Desc)], map: "idx_task_created_at")
  @@index([tenant_id, created_by], map: "idx_task_created_by")
  @@index([tenant_id, due_date], map: "idx_task_due_date")
  @@index([tenant_id, assigned_to_employee_id], map: "idx_task_employee")
  @@index([tenant_id, status], map: "idx_task_status")
  @@index([tenant_id, subcategory_id], map: "idx_task_subcategory")
  @@index([tenant_id], map: "idx_task_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model task_history {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String   @db.Uuid
  task_id            String   @db.Uuid
  changed_by_user_id String?  @db.Uuid
  action             String   @db.VarChar(100)
  old_value          Json?
  new_value          Json?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  users              User?    @relation(fields: [changed_by_user_id], references: [id], onUpdate: NoAction)
  task               task     @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant             tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([task_id, created_at(sort: Desc)], map: "idx_task_history_created")
  @@index([task_id], map: "idx_task_history_task")
  @@index([changed_by_user_id], map: "idx_task_history_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model task_payment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String         @db.Uuid
  task_id        String         @db.Uuid
  payment_type   String         @db.VarChar(100)
  amount         Decimal        @db.Decimal(12, 2)
  payment_status payment_status
  paid_at        DateTime?      @db.Timestamptz(6)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  task           task           @relation(fields: [task_id], references: [id], onUpdate: NoAction)
  tenant         tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([payment_status], map: "idx_task_payment_status")
  @@index([task_id], map: "idx_task_payment_task")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model task_reimbursement {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String               @db.Uuid
  task_id     String               @db.Uuid
  amount      Decimal              @db.Decimal(12, 2)
  proof_file  String?
  description String?
  status      reimbursement_status
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  updated_at  DateTime             @default(now()) @db.Timestamptz(6)
  task        task                 @relation(fields: [task_id], references: [id], onUpdate: NoAction)
  tenant      tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_task_reimbursement_status")
  @@index([task_id], map: "idx_task_reimbursement_task")
}

model join_request {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String              @db.Uuid
  name          String              @db.VarChar(255)
  email         String              @db.VarChar(255)
  password_hash String              @default("")
  status        join_request_status @default(PENDING)
  assigned_role user_role?
  responded_by  String?             @db.Uuid
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at    DateTime            @default(now()) @db.Timestamptz(6)
  tenant        tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  responder     User?               @relation("join_request_responder", fields: [responded_by], references: [id], onUpdate: NoAction)

  @@unique([tenant_id, email])
  @@index([tenant_id, status], map: "idx_join_request_status")
}

model tenant {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String               @db.VarChar(255)
  subdomain          String               @unique @db.VarChar(100)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  categories         categories[]
  client             client[]
  client_group       client_group[]
  join_request       join_request[]
  notifications      notifications[]
  sub_categories     sub_categories[]
  task               task[]
  task_history       task_history[]
  task_payment       task_payment[]
  task_reimbursement task_reimbursement[]
  tenant_config      tenant_config[]
  users              User[]
}

model tenant_config {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String   @db.Uuid
  config_key   String   @db.VarChar(100)
  config_value Json     @default("{}")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  tenant       tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, config_key], map: "tenant_config_unique_key")
}

enum payment_status {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum reimbursement_status {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum task_priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum task_status {
  TODO
  IN_PROGRESS
  WAITING_CLIENT
  REVIEW
  COMPLETED
  CANCELLED
}

enum join_request_status {
  PENDING
  APPROVED
  REJECTED
}

enum user_role {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}
