// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
  suspended
}

enum TenantStatus {
  active
  suspended
  archived
}

enum TenantPlan {
  free
  starter
  professional
  enterprise
}

enum RoleName {
  owner
  admin
  manager
  employee
}

model Tenant {
  id     String       @id @default(uuid()) @db.Uuid
  name   String
  slug   String       @unique
  status TenantStatus @default(active)

  // Branding
  logoUrl      String? @map("logo_url")
  primaryColor String? @map("primary_color")
  timezone     String  @default("UTC")
  currency     String  @default("USD")
  locale       String  @default("en-US")

  // Subscription
  plan         TenantPlan @default(free)
  userLimit    Int        @default(5) @map("user_limit")
  storageLimit Int        @default(1024) @map("storage_limit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  roles     Role[]
  settings  TenantSettings?
  employees Employee[]
  clients   Client[]
  tasks     Task[]

  @@map("tenants")
}

model TenantSettings {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  dateFormat          String @default("YYYY-MM-DD") @map("date_format")
  timeFormat          String @default("HH:mm") @map("time_format")
  weekStartsOn        Int    @default(1) @map("week_starts_on")
  fiscalYearStartMonth Int   @default(1) @map("fiscal_year_start_month")
  invoicePrefix       String @default("INV") @map("invoice_prefix")
  employeeIdPrefix    String @default("EMP") @map("employee_id_prefix")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleName
  tenantId  String   @map("tenant_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id         String     @id @default(uuid()) @db.Uuid
  authUserId String     @unique @map("auth_user_id") @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  roleId     String     @map("role_id") @db.Uuid
  email      String
  status     UserStatus @default(active)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  role     Role      @relation(fields: [roleId], references: [id])
  employee Employee?

  @@map("users")
}

enum EmployeeStatus {
  active
  inactive
  suspended
  resigned
}

enum EmploymentType {
  full_time
  part_time
  contract
  intern
  consultant
}

model Employee {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  userId       String?        @unique @map("user_id") @db.Uuid
  employeeCode String         @map("employee_code")

  // Personal
  firstName    String         @map("first_name")
  lastName     String         @map("last_name")
  fullName     String         @map("full_name")
  email        String
  phone        String?
  profileImage String?        @map("profile_image")

  // Organization
  department   String?
  designation  String?
  reportingManagerId String?  @map("reporting_manager_id") @db.Uuid

  // Employment
  joinedAt       DateTime       @default(now()) @map("joined_at")
  employmentType EmploymentType @default(full_time) @map("employment_type")
  status         EmployeeStatus @default(active)

  // Audit
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  user             User?     @relation(fields: [userId], references: [id])
  reportingManager Employee? @relation("EmployeeReporting", fields: [reportingManagerId], references: [id])
  directReports    Employee[] @relation("EmployeeReporting")
  managedClients   Client[]  @relation("AccountManager")
  assignedTasks    Task[]    @relation("TaskAssignee")
  tasksAssignedBy  Task[]    @relation("TaskAssigner")

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, department])
  @@index([tenantId, fullName])
  @@map("employees")
}

enum ClientType {
  company
  individual
  partnership
  llp
  trust
  ngo
  government
}

enum ClientStatus {
  active
  inactive
  archived
}

model Client {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  clientCode String     @map("client_code")

  // Business
  legalName  String     @map("legal_name")
  tradeName  String?    @map("trade_name")
  clientType ClientType @default(company) @map("client_type")

  // Registration
  pan   String?
  gstin String?
  cin   String?

  // Contact
  primaryEmail String?  @map("primary_email")
  primaryPhone String?  @map("primary_phone")
  website      String?

  // Address
  addressLine1 String?  @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  city         String?
  state        String?
  country      String?  @default("India")
  postalCode   String?  @map("postal_code")

  // Ownership
  accountManagerId String? @map("account_manager_id") @db.Uuid

  // Status
  status ClientStatus @default(active)

  // Metadata
  onboardingDate DateTime? @map("onboarding_date")
  tags           String[]  @default([])
  remarks        String?

  // Audit
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  accountManager Employee? @relation("AccountManager", fields: [accountManagerId], references: [id])
  tasks          Task[]

  @@unique([tenantId, clientCode])
  @@unique([tenantId, pan])
  @@unique([tenantId, gstin])
  @@index([tenantId, status])
  @@index([tenantId, legalName])
  @@index([tenantId, clientType])
  @@index([tenantId, accountManagerId])
  @@map("clients")
}

enum TaskStatus {
  todo
  in_progress
  blocked
  review
  completed
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  critical
}

model Task {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  clientId String? @map("client_id") @db.Uuid
  taskCode String @map("task_code")

  // Basic
  title       String
  description String?

  // Assignment
  assignedTo String? @map("assigned_to") @db.Uuid
  assignedBy String? @map("assigned_by") @db.Uuid

  // Classification
  priority TaskPriority @default(medium)
  status   TaskStatus   @default(todo)
  category String?

  // Scheduling
  startDate   DateTime? @map("start_date")
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")

  // Metadata
  estimatedHours Float? @map("estimated_hours")
  actualHours    Float? @map("actual_hours")

  // Audit
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  client   Client?   @relation(fields: [clientId], references: [id])
  assignee Employee? @relation("TaskAssignee", fields: [assignedTo], references: [id])
  assigner Employee? @relation("TaskAssigner", fields: [assignedBy], references: [id])

  @@unique([tenantId, taskCode])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, assignedTo])
  @@index([tenantId, clientId])
  @@index([tenantId, dueDate])
  @@index([tenantId, category])
  @@map("tasks")
}
