{
  "name": "fin-crm",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "supabase": "^2.110.0",
    "turbo": "^2.10.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "4.14.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
